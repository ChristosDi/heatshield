# Copy this file to .env and fill in the values. Never commit .env.

# Django UI
# Make a key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# True only on your own machine
DJANGO_DEBUG=True

# Where Django finds the Flask API. Change the port if 5000 is taken on your machine (for example 5001).
FLASK_API_URL=http://127.0.0.1:5000

# AI adapter. "fake" (the default) uses recorded answers and needs no key or network.
# "real" calls a chat-completions service in the OpenAI format (the team uses the Gemini API free tier).
AI_MODE=fake
# Gemini (team choice): https://generativelanguage.googleapis.com/v1beta/openai   Backup, Groq: https://api.groq.com/openai/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Copy the name of a stable (not preview) model from Google AI Studio
AI_MODEL=
# Your own key, only in .env. Never commit it or paste it into any chat or AI tool.
AI_API_KEY=
